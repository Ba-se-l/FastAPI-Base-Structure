# ———————— Application ————————
APP_TITLE=FastAPI Base Structure
APP_VERSION=1.0.0
APP_DESCRIPTION=Your project description here

# ———————— Server ————————
HOST=127.0.0.1
PORT=8000
RELOAD=false
ENVIRONMENT=dev  # dev | pro

# ———————— CORS ————————
# JSON array of allowed origins. Use ["*"] ONLY in dev.
ALLOWED_ORIGINS=["*"]
ALLOWED_HEADERS=["*"]
ALLOW_METHODS=["GET","POST","PATCH","DELETE"]

# ———————— Database ————————
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./database.db
# PostgreSQL (pro):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
ECHO=false

# ———————— JWT Secrets ————————
# CRITICAL: Replace these before deploying to production!
ACCESS_SECRET_KEY=placeholder-change-it-in-production-mode
REFRESH_SECRET_KEY=placeholder-change-it-in-production-mode
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30

# ———————— Session ————————
AUTOFLUSH=false
EXPIRE_ON_COMMIT=false

# ———————— API ————————
API_PREFIX=/api/v1

# ———————— Audit & Logging ————————
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_DB=true

